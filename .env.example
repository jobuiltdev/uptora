# Django
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=uptora
DB_USER=uptora_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5433

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
UPTORA_DISPATCH_INTERVAL_SECONDS=30

# Notifications
# Without RESEND_API_KEY, development uses the console provider: it logs the
# message and marks the delivery `console:` rather than pretending to send.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Uptora <alerts@uptora.example>
APP_BASE_URL=http://localhost:8000
UPTORA_NOTIFICATION_DISPATCH_INTERVAL_SECONDS=60
